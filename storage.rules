rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Global fallback blocks unauthorized uploads
    match /{allPaths=**} {
      allow read, write: if false;
    }

    match /media/{userId}/{fileId} {
      // Advertisements must be publicly readable by kiosk screens
      allow read: if true;
      
      // Writes are restricted to authenticated admins, enforcing rigorous sizing constraints
      allow write: if request.auth != null && 
                      request.auth.uid == userId &&
                      (
                        // Verify image boundaries (max 20MB)
                        (request.resource.contentType.matches('image/.*') && request.resource.size < 20 * 1024 * 1024) ||
                        // Verify video boundaries (max 500MB)
                        (request.resource.contentType.matches('video/.*') && request.resource.size < 500 * 1024 * 1024)
                      );
    }
  }
}
