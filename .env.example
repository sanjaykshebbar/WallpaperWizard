# WallpaperWizard runs as one Docker container; these are optional.

# Encryption key for the saved device admin password. Any long random string.
# If unset, a random key is generated in /app/data/secret.key (same volume as the database).
# Set this before saving the device password; changing it later means re-entering the password.
WW_SECRET_KEY=""

# Optional reachable origin for setup links. Use HTTPS for a public deployment.
# On a local LAN, for example: WW_SETUP_BASE_URL="http://192.168.1.20:3000"
WW_SETUP_BASE_URL=""
