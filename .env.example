# Supabase Configuration
# Provide these variables to fully run the application on Supabase instead of Firebase.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Local self-hosted backend (Docker / LAN mode)
# Set to "true" at build time to route all data calls through the bundled Express API.
VITE_LOCAL_BACKEND="false"

# --- In-app feedback -> GitHub issues ---

# Repository that feedback issues are filed against (owner/repo).
VITE_GITHUB_REPO="sanjaykshebbar/Adboard_v4"

# Is that repository private? A private repo cannot accept issues via the
# pre-fill URL (the submitter would need to be a signed-in collaborator), so
# when true the app requires the server-side token below and never opens a
# broken GitHub page. Set to "false" only for a public repo/fork.
VITE_GITHUB_REPO_PRIVATE="true"

# Server-side auto-create (REQUIRED for a private repo). These are NOT VITE_
# vars — they stay on the server (Vercel function / self-hosted Express) and are
# never shipped to the browser. Create a fine-grained PAT with "Issues: write"
# on the repo. Without these, feedback on a private repo cannot be filed.
GITHUB_TOKEN="github_pat_..."
GITHUB_REPO="sanjaykshebbar/Adboard_v4"
